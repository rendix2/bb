services:
	RouterFactory: App\Core\RouterFactory::createRouter
	- App\Model\Service\MarkdownRenderer
	MysqlDumper:
		class: Ifsnop\Mysqldump\Mysqldump(%database.default.dsn%, %database.default.username%, %database.default.password%)
	BBMailer:
		class: App\Controls\BBMailer
	GridFilter:
		factory: App\Controls\GridFilter
	UserSearchControl:
		factory:  App\Controls\UserSearchControl
	PollControl:
		factory:  App\Controls\PollControl

	-
		type: App\Model\Repository\UserRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\UserEntity)

	-
		type: App\Model\Repository\LanguageRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\LanguageEntity)

	-
		type: App\Model\Repository\CategoryRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\CategoryEntity)

	-
		type: App\Model\Repository\ForumRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\ForumEntity)

	-
		type: App\Model\Repository\TopicRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\TopicEntity)

	-
		type: App\Model\Repository\PostRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\PostEntity)

	-
		type: App\Model\Repository\ThankRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\ThankEntity)

	-
		type: App\Model\Repository\TopicWatchRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\TopicWatchEntity)

	-
		type: App\Model\Repository\PollRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\PollEntity)

	-
		type: App\Model\Repository\PollAnswerRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\PollAnswerEntity)

	-
		type: App\Model\Repository\PollVoteRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\PollVoteEntity)

	-
		type: App\Model\Repository\RankRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\RankEntity)

	-
		type: App\Model\Repository\ReportRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\ReportEntity)

	-
		type: App\Model\Repository\SessionRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\SessionEntity)

	-
		type: App\Model\Repository\UserFavouriteUserRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\UserFavouriteUserEntity)

	-
		type: App\Model\Repository\UserActivationRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\UserActivationEntity)

	-
		type: App\Model\Repository\GroupRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\GroupEntity)

	-
		type: App\Model\Repository\GroupForumPermissionRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\GroupForumPermissionEntity)

	-
		type: App\Model\Repository\FileRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\FileEntity)

	-
		type: App\Model\Repository\UserModeratorRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\UserModeratorEntity)

	-
		type: App\Model\Repository\UserForumPermissionRepository
		factory: @nettrine.orm.managers.default.entityManagerDecorator::getRepository(App\Model\Entity\UserForumPermissionEntity)


search:
	-   in: %appDir%
		classes:
			- *Factory
			- *Facade
			- *Grid
			- *Service
			#- *Manager
			- *Dir
			- *Form



includes:
	- ext/console.neon
	- ext/guzzle.neon
	- ext/nettrine.neon
	- ext/translation.neon
	- ext/menu.neon
	- ext/mailing.neon
	- ext/redis.neon
	- settings.neon
	#- config.neon
	- factory.neon
	- managers.neon