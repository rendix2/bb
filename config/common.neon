parameters:
    defaultLanguage: "czech"
    # images of contributte/imagist (config/ext/imagist.neon): OUTSIDE www/, originals in media/<scope>/, thumbnails in
    # cache/<scope>/_<filter>/; served by the presenter Web:Image (only thumbnails of existing users)
    imagesDir: %appDir%/../data/images
    # avatars of users (App\Model\Service\UserAvatarService): only static images (JPEG, PNG, GIF, WebP; an animated GIF is
    # refused), re-encoded to a 256x256 WebP (drops EXIF, appended data and animation), thumbnails 128 and 48 px made on upload
    avatars:
        relativeDir: /avatars # only the old code (app/*Module)
        dir: %imagesDir%/media/avatars
        maxWidth: 2000 # of the uploaded image, checked before it is decoded
        maxHeight: 2000
        maxFileSize: 5242880 # 5 MB
        enabledExtension: # only the old code (app/*Module)
            - jpg
            - jpeg
            - png
            - gif
            - webp
    ranks:
        relativeDir: /ranks
        dir: %wwwDir%%ranks.relativeDir%
        maxWidth: 2000 # of the uploaded image, checked before it is decoded (RankImageService)
        maxHeight: 2000
        maxFileSize: 1048576 # 1 MB
        enabledExtension:
            - jpg
            - jpeg
            - png
            - gif
    crud:
        cache:
            primaryKey: 10 days
    categories:
    forums:
        pagination:
            itemsPerPage: 25
            itemsAroundPagination: 5
    topics:
        pagination:
            itemsPerPage: 4
            itemsAroundPagination: 5
        cache:
            lastTopic: 1 hour
            totalTopics: 1 hour
            primaryKey: 10 day
        logViews: true
        # how many days the old forum shows "moved to ..." after a moderator moved a topic away (Forum:Topic:Move)
        movedNoticeDays: 7
    posts:
        cache:
            totalPosts: 1 hour
            primaryKey: 10 day
        filesDir: %wwwDir%/postFiles
        # attachments of posts (App\Model\Service\AttachmentService): stored OUTSIDE www/ under random names, served by a presenter
        attachments:
            dir: %appDir%/../data/attachments
            maxSize: 5242880 # 5 MB per file
            maxFiles: 5 # per post
            # the type is detected from the content (finfo), never taken from the client
            allowedTypes:
                image/jpeg: jpg
                image/png: png
                image/gif: gif
                image/webp: webp
                application/pdf: pdf
                application/zip: zip
                text/plain: txt
        minLength: 5 # int or null
        maxLength: 100000 # int or null
        minUserTimeInterval: 20
        minDoublePostTimeInterval: 300 # this value must be bigger than minUserTimeInterval
        signatureDelimiter: "<hr>"
    users:
        cache:
            lastUser: 1 hour
            totalUser: 1 hour
            primaryKey: 10 day
        canChangeUserName: false
        canDelete: false
        canDeletePostCount: false
        neededLogin: true
        neededActivate: true
        minUserNameLength: 3
        minUserPasswordLength: 8
        signatureMaxLength: 1000 # characters of the Markdown signature (Web:User:Edit)
    search:
        minLength: 3
    mail:
        from: rendix2@gmail.com
        templateDir: %wwwDir%/controls/templates/emails
    databaseBackupDir: %tempDir%/dumps
    startDay: 1.3.2018 00:00


application:
    debugger: true
    errorPresenter:
        4xx: Error:Error4xx
        5xx: Error:Error5xx
    mapping:
        *: App\UI\*\**Presenter


session:
    debugger: true
    expiration: 14 days
    autoStart: smart

latte:
    debugger: true
    strictParsing: yes
    strictTypes: true
    locale: cs_CZ
    extensions:
        - App\UI\Accessory\LatteExtension

di:
    debugger: true
    export:
        parameters: true
        tags: true

http:
    cookieSecure: auto

security:
    debugger: true

routing:
    debugger: true
    cache: true

tracy:
    maxLength: 500
    maxDepth: 10
    showLocation: true
    strictMode: true
    showBar: true

assets:
    basePath: /var/www/html/www
    mapping:
        default:
            type: vite
            path: assets
        styles:
            path: css


#mail:
    #smtp: %mail.smtp%

    #host: %mail.host%
    #port: %mail.port%
    #username: %mail.username%
    #password: %mail.password%
    #timeout: ...     # (int)
    #encryption: ...  # (ssl|tls|null) výchozí je null (má alias 'secure')
    #clientHost: ...  # (string) výchozí je $_SERVER['HTTP_HOST']
    #persistent: ...  # (bool) výchozí je false

services:
    -
        create: App\Core\UsernameAndPasswordAuthenticator
        autowired: self

    -
        create: App\Core\AutoLoginAuthenticator
        autowired: self

    # "stay logged in" on every page: the cookie logs the visitor in, a deactivated user is logged out (AutoLoginService)
    application.application:
        setup:
            - '$onPresenter[]' = [@App\Core\AutoLoginService, tryLogin]
            # the language of the interface from the settings of the logged-in user (after the cookie login above)
            - '$onPresenter[]' = [@App\Core\Translation\UserLocaleService, onPresenter]
            # bans of the whole web and of the login (after the cookie login above): log out, the page of the ban
            - '$onPresenter[]' = [@App\Core\BanGuard, onPresenter]

    # the login form answers in the same request: its page already in the language of the user (UserLocaleService)
    security.user:
        setup:
            - '$onLoggedIn[]' = [@App\Core\Translation\UserLocaleService, onUserChanged]
            - '$onLoggedOut[]' = [@App\Core\Translation\UserLocaleService, onUserChanged]

extensions:
    chatbot: App\DI\ServicesExtension
    dibi: Dibi\Bridges\Nette\DibiExtension3

dibi:
    driver: PDO
    port: 3306
    database: %database.default.database%
    username: %database.default.username%
    password: %database.default.password%
    lazy: TRUE
    dsn: %database.default.dsn%