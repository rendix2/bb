extensions:
    translation: Contributte\Translation\DI\TranslationExtension

translation:
    locales:
        whitelist: [en, cs, sk]
        default: cs
        fallback: [cs]
    dirs:
        - %appDir%
    returnOriginalMessage: true # to not translate undefined messages, default is true
    # the language of the settings of the logged-in user (users.language), a guest the default (cs)
    localeResolvers:
        - App\Core\Translation\UserLocaleResolver
        - Contributte\Translation\LocalesResolvers\Router
    loaders:
        json: Symfony\Component\Translation\Loader\JsonFileLoader