extensions:
    menu: Contributte\MenuControl\DI\MenuExtension

menu:
    web:
        items:
            Home:
                action: :Web:Home:default
    admin:
        templates:
            menu: %appDir%/UI/Admin/menu/menu.latte
            breadcrumbs: %appDir%/UI/Admin/menu/breadcrumbs.latte
        items:
            Dashboard:
                action: :Admin:Dashboard:default
            Users:
                action: :Admin:User:List:default
                include:
                    - '^Admin:User:Edit:default'
                    - '^Admin:User:Forum:default'
            Roles:
                action: :Admin:Role:List:default
                include:
                    - '^Admin:Role:Edit:default'
            Categories:
                action: :Admin:Category:List:default
                include:
                    - '^Admin:Category:'
            Forums:
                action: :Admin:Forum:List:default
                include:
                    - '^Admin:Forum:'
            Groups:
                action: :Admin:Group:List:default
                include:
                    - '^Admin:Group:'
            Bans:
                action: :Admin:Ban:List:default
                include:
                    - '^Admin:Ban'
            Ranks:
                action: :Admin:Rank:List:default
                include:
                    - '^Admin:Rank:'
            Languages:
                action: :Admin:Language:List:default
                include:
                    - '^Admin:Language:'
            Faq:
                action: :Admin:Faq:List:default
                include:
                    - '^Admin:Faq:'
            Reports:
                action: :Admin:Report:List:default
                include:
                    - '^Admin:Report:'
