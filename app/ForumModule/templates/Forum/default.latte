{define title}{_menu_forum} {$forum->name}{/define}

{define breadCrumb}
    <div class="float-left">
        {control breadCrumbAll}
    </div>
{/define}

{block content}

    <div class="col-sm-12">
        <div class="float-left">
            <h1>{_forum}: {$forum->name}</h1>
        </div>
        {if $canAddTopic}
            <div class="float-right">
                <a class="btn btn-primary" href="{link Topic:edit, $category_id, $forum_id}">
                    <i class="fa fa-plus" aria-hidden="true"></i>
                    {_topic_add_new}
                </a>
            </div>
        {/if}
          
    </div>

    <div class="col-sm-12">
        <div class="float-left">
            {if $subForums}
                {_forum_subforums}:
                <ul>
                    {foreach $subForums as $subForum}
                        <li>
                            <a href="{link Forum:default, $subForum->forum_category_id, $subForum->forum_id}">{$subForum->forum_name}</a>
                        </li>
                    {/foreach}
                </ul>
            {/if}
        </div>
        {*
        <div class="float-right">
            {control paginator}
        </div>
        *}
    </div>

    <div class="col-sm-12 main">
        {include breadCrumb}
        <div class="float-right">
            <a href="{link :Forum:Forum:Rules:default, $forum->category->id, $forum->id}">{_forum_rules}</a>

            {if count($moderators)}
            <br>
            {_moderators}:
            
                {foreach $moderators as $moderator}
                    <a href="{link User:profile $moderator->id}">{$moderator->username}</a>
                {/foreach}
            {/if}
        </div>

        {control dataGrid}
    </div>

    <div class="col-sm-12">
        {include breadCrumb}
    </div>
{/block}
