{block content}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0">
                <!-- Header s jemným pozadím a ikonou -->
                <div class="card-header bg-light border-bottom p-4">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                            <i class="fas fa-user-edit"></i> <!-- Pokud máš FontAwesome, jinak klidně bez <i> -->
                        </div>
                        <div>
                            <h1 class="h4 mb-0 fw-bold text-dark">{_web-user-edit.form.header}</h1>
                            <small class="text-muted">{_web-user-edit.form.subtitle}</small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <!-- Samotný Nette formulář -->
                    <div class="edit-form-container">
                        {control editForm}
                    </div>

                    <div class="mt-4 pt-3 border-top avatar-settings">
                        <h2 class="h6">{_web-user-edit.avatar.header}</h2>
                        <div n:if="$avatar" class="d-flex align-items-center mb-3">
                            <img n:img="$avatar, filter: avatar128" alt="" width="128" height="128" class="rounded-circle me-3 current-avatar">
                            <div class="avatar-delete-form">{control avatarDeleteForm}</div>
                        </div>
                        <div class="avatar-form">{control avatarForm}</div>
                    </div>

                    <div n:if="$signature" class="mt-4 signature-preview">
                        <h2 class="h6">{_web-user-edit.form.signature.preview}</h2>
                        <div class="small text-muted border-top pt-2">{$signature|markdown}</div>
                    </div>
                </div>

                <!-- Footer s odkazem zpět (volitelné) -->
                <div class="card-footer bg-transparent border-0 text-center pb-4">
                    <a href="javascript:history.back()" class="btn btn-link text-decoration-none text-muted small">
                        <i class="fas fa-arrow-left me-1"></i> {_web-user-edit.back}
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{/block}