{block title}{_admin-mail-create.title}{/block}

{block content}
    <div class="card shadow-sm border-0 mt-3 col-lg-8">
        <div class="card-header bg-white py-3"><h1 class="h6 m-0 fw-bold text-primary">{_admin-mail-create.title}</h1></div>
        <div class="card-body">
            <p class="mail-recipient-count">{_admin-mail-create.recipients, [count: $recipientCount]}</p>
            {control mailForm}
        </div>
    </div>
    <a n:href=":Admin:Mail:List:default" class="btn btn-link">{_admin-mail-create.back}</a>
{/block}
