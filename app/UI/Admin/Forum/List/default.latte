{block title}{_admin-forum-list.title}{/block}

{block content}
    <a n:href=":Admin:Forum:Create:default" class="btn btn-secondary mt-1 forum-create-link">
        <i class="fa-solid fa-plus"></i> {_admin-forum-list.create}
    </a>

    <div class="card shadow-sm border-0 mt-3">
        <div class="card-header bg-white py-3">
            <h1 class="h6 m-0 fw-bold text-primary">{_admin-forum-list.title}</h1>
        </div>
        <div class="card-body">
            {control grid}
        </div>
    </div>
{/block}
