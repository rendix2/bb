{block title}{_admin-dashboard.title}{/block}

{block content}
    <h1 class="h4 mt-3">{_admin-dashboard.title}</h1>

    <div class="row g-3 dashboard">
        <div n:foreach="$stats as $key => $value" class="col-6 col-md-3">
            <div class="card shadow-sm border-0 h-100 dashboard-{$key}">
                <div class="card-body">
                    <div class="small text-muted">{_"admin-dashboard.$key"}</div>
                    <div class="fs-3 fw-bold dashboard-value">{$value}</div>
                </div>
            </div>
        </div>
    </div>

    <p class="mt-3">
        <a n:href=":Admin:Report:List:default" class="btn btn-outline-primary dashboard-reports-link">{_admin-dashboard.toReports}</a>
        <a n:href=":Forum:Index:default" class="btn btn-link">{_admin-dashboard.toForum}</a>
    </p>
{/block}
