{block title}{_admin-rank-edit.title}: {$rank->name}{/block}

{block content}
    <div class="card shadow-sm border-0 mt-3 col-lg-6">
        <div class="card-header bg-white py-3"><h1 class="h6 m-0 fw-bold text-primary">{_admin-rank-edit.title}: {$rank->name}</h1></div>
        <div class="card-body">
            <img n:if="$rank->image" n:img="$rank->image, filter: rank" alt="" class="mb-3 rank-image">
            {control rankForm}
        </div>
    </div>
    <a n:href=":Admin:Rank:List:default" class="btn btn-link">{_admin-rank-edit.back}</a>
{/block}
