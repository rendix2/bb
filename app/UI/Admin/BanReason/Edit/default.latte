{block title}{_admin-ban-reason-edit.title}: {$reason->text|truncate:40}{/block}

{block content}
    <div class="card shadow-sm border-0 mt-3 col-lg-6">
        <div class="card-header bg-white py-3"><h1 class="h6 m-0 fw-bold text-primary">{_admin-ban-reason-edit.title}: {$reason->text|truncate:40}</h1></div>
        <div class="card-body">{control reasonForm}</div>
    </div>
    <a n:href=":Admin:BanReason:List:default" class="btn btn-link">{_admin-ban-reason-edit.back}</a>
{/block}
