{block title}{_admin-ban-edit.title}: #{$ban->id}{/block}

{block content}
    <div class="card shadow-sm border-0 mt-3 col-lg-6">
        <div class="card-header bg-white py-3"><h1 class="h6 m-0 fw-bold text-primary">{_admin-ban-edit.title}: #{$ban->id}</h1></div>
        <div class="card-body">{control banForm}</div>
    </div>
    <a n:href=":Admin:Ban:List:default" class="btn btn-link">{_admin-ban-edit.back}</a>
{/block}
