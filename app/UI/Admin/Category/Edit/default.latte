{block title}{_admin-category-edit.title}: {$category->name}{/block}

{block content}
    <div class="card shadow-sm border-0 mt-3 col-lg-6">
        <div class="card-header bg-white py-3"><h1 class="h6 m-0 fw-bold text-primary">{_admin-category-edit.title}: {$category->name}</h1></div>
        <div class="card-body">{control categoryForm}</div>
    </div>
    <a n:href=":Admin:Category:List:default" class="btn btn-link">{_admin-category-edit.back}</a>
{/block}
