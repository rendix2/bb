{block title}{_admin-faq-create.title}{/block}

{block content}
    <div class="card shadow-sm border-0 mt-3 col-lg-8">
        <div class="card-header bg-white py-3"><h1 class="h6 m-0 fw-bold text-primary">{_admin-faq-create.title}</h1></div>
        <div class="card-body">{control faqForm}</div>
    </div>
    <a n:href=":Admin:Faq:List:default" class="btn btn-link">{_admin-faq-create.back}</a>
{/block}
