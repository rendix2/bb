{block title}{$topic->name}{/block}

{block content}
    {include '../../@breadcrumb.latte', category: $topic->category, forum: $topic->forum, topic: $topic}

    <h1>
        <span n:if="$topic->isLocked" class="topic-locked" title={_forum-topic-view.locked}>&#128274;</span>
        {$topic->name}
    </h1>

    {include '../../@paginator.latte', paginator: $paginator}

    <div n:if="$poll" class="card mb-3 poll">
        <div class="card-header">
            <strong class="poll-question">{$poll->question}</strong>
            <span n:if="$poll->endsAt" class="small text-muted">({if $pollOpen}{_forum-topic-view.pollEnds}{else}{_forum-topic-view.pollEnded}{/if} {$poll->endsAt|date:'j. n. Y H:i'})</span>
        </div>
        <div class="card-body">
            {var $total = array_sum(array_column($pollResults, 'votes'))}
            <div n:foreach="$pollResults as $row" class="poll-answer">
                {$row['answer']->text}: <span class="poll-votes">{$row['votes']}</span>
                ({$total > 0 ? round($row['votes'] / $total * 100) : 0} %)
            </div>
            <div n:if="$canVote" class="poll-vote-form mt-2">{control voteForm}</div>
        </div>
    </div>
    <p n:if="$canAddPoll"><a n:href=":Forum:Topic:Poll:default $topic->uuid->toString()" class="btn btn-outline-primary btn-sm add-poll-link">{_forum-topic-view.addPoll}</a></p>

    <div n:foreach="$posts as $post" id="post-{$post->id}" class="card mb-3 post">
        <div class="card-header d-flex justify-content-between">
            <span>
                {* the avatar (thumbnail 48 px made on upload, public like the topic; Web:Image) *}
                <img n:if="$post->user->avatar" n:img="$post->user->avatar, filter: avatar48" alt="" width="48" height="48" class="rounded-circle me-1 post-avatar">
                <a n:href=":Web:User:View:default $post->user->uuid->toString()" class="post-author">{$post->user->username}</a>
                <span n:if="$ranks[$post->user->id]" class="badge badge-secondary post-rank">{$ranks[$post->user->id]->name}</span>
                <img n:if="$ranks[$post->user->id]?->image" n:img="$ranks[$post->user->id]->image, filter: rank" alt="" class="post-rank-image d-block mt-1">
                <span class="small text-muted">{_forum-topic-view.posts}: <span class="post-count">{$postCounts[$post->user->id]}</span></span>
            </span>
            <span class="small text-muted">
                {$post->createdAt|date:'j. n. Y H:i'}
                <span n:if="$post->updatedAt" class="post-edited">({_forum-topic-view.edited} {$post->updatedAt|date:'j. n. Y H:i'}<a n:if="$canViewHistory[$post->id]" n:href=":Forum:Post:History:default $post->uuid->toString()" class="post-history-link ms-1">{_forum-topic-view.history}</a>)</span>
                <a n:if="$canReply" n:href=":Forum:Topic:Reply:default $topic->uuid->toString(), quote: $post->uuid->toString()" class="post-quote-link">{_forum-topic-view.quote}</a>
                <a n:if="$canEdit[$post->id]" n:href=":Forum:Post:Edit:default $post->uuid->toString()" class="post-edit-link">{_forum-topic-view.edit}</a>
                <a n:if="$canDelete[$post->id]" n:href=":Forum:Post:Delete:default $post->uuid->toString()" class="post-delete-link">{_forum-topic-view.delete}</a>
                <a n:if="$canReport[$post->id]" n:href=":Forum:Post:Report:default $post->uuid->toString()" class="post-report-link">{_forum-topic-view.report}</a>
                <span n:if="$post->isLocked" class="post-locked" title={_forum-topic-view.postLocked}>&#128274;</span>
                <span class="post-thanks small">{_forum-topic-view.thanks}: <span class="post-thank-count">{$postThanks['counts'][$post->id]}</span></span>
                <span n:if="$canThank && $post->user->id !== $user->getId() && !isset($postThanks['thankedByUser'][$post->id])" class="post-thank-form d-inline-block">{control "thankPostForm-$post->id"}</span>
                <span n:if="$canModerate" class="post-lock-form d-inline-block">{control "lockPostForm-$post->id"}</span>
            </span>
        </div>
        <div class="card-body">
            <h5 n:if="$post->title" class="card-title">{$post->title}</h5>
            <div class="post-text">{$post->text|markdown}</div>
            <ul n:if="isset($attachments[$post->id])" class="post-attachments small">
                <li n:foreach="$attachments[$post->id] as $file">
                    <a n:href=":Forum:Post:Attachment:default $file->uuid->toString()">{$file->originalName}</a>
                    ({$file->size|bytes})
                </li>
            </ul>
            <div n:if="$post->user->signature" class="post-signature small text-muted">
                <hr>
                {$post->user->signature|markdown}
            </div>
        </div>
    </div>

    {include '../../@paginator.latte', paginator: $paginator}

    <div class="topic-actions mb-2">
        <span class="topic-thanks">{_forum-topic-view.topicThanks}: <span class="topic-thank-count">{$topicThankCount}</span></span>
        <span n:if="$canThank && $topic->user->id !== $user->getId() && !$hasThankedTopic" class="topic-thank-form d-inline-block">{control thankTopicForm}</span>
        <span n:if="$user->isLoggedIn()" class="topic-watch-form d-inline-block">{control watchForm}</span>
    </div>
    <p class="topic-lists small">
        <a n:href=":Forum:Topic:Thanks:default $topic->uuid->toString()" class="topic-thanks-link">{_forum-topic-view.whoThanked}</a>
        · <a n:href=":Forum:Topic:Attachments:default $topic->uuid->toString()" class="topic-attachments-link">{_forum-topic-view.attachments}</a>
        <span n:if="$canModerate">· <a n:href=":Forum:Topic:Watchers:default $topic->uuid->toString()" class="topic-watchers-link">{_forum-topic-view.watchers}</a></span>
        <span n:if="$canModerate">· <a n:href=":Forum:Topic:Move:default $topic->uuid->toString()" class="topic-move-link">{_forum-topic-view.move}</a></span>
    </p>
    <div n:if="$canModerate" class="topic-lock-form mb-2">{control lockTopicForm}</div>
    <p n:if="$canDeleteTopic"><a n:href=":Forum:Topic:Delete:default $topic->uuid->toString()" class="btn btn-outline-danger btn-sm topic-delete-link">{_forum-topic-view.deleteTopic}</a></p>
    <p n:if="$topic->isLocked" class="alert alert-secondary">{_forum-topic-view.lockedNotice}</p>
    <p n:if="$canReply"><a n:href=":Forum:Topic:Reply:default $topic->uuid->toString()" class="btn btn-primary reply-link">{_forum-topic-view.reply}</a></p>

    <div class="forum-jump-box mb-3">{control forumJumpForm}</div>

    <div n:if="$canFastReply" class="card fast-reply">
        <div class="card-header">{_forum-topic-view.fastReply}</div>
        <div class="card-body">{control fastReplyForm}</div>
    </div>
{/block}
