{block title}{_forum-topic-create.title}: {$forum->name}{/block}

{block content}
    {include '../../@breadcrumb.latte', category: $forum->category, forum: $forum}

    <h1>{_forum-topic-create.title}</h1>

    <div n:if="$preview !== null" class="card mb-3 post-preview">
        <div class="card-header">{_forum-topic-create.form.preview}</div>
        <div class="card-body">{$preview|markdown}</div>
    </div>

    {control createTopicForm}

    <p class="small text-muted">{_forum-topic-create.markdownHint}</p>
{/block}
