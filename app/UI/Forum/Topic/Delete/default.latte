{block title}{_forum-topic-delete.title}: {$topic->name}{/block}

{block content}
    {include '../../@breadcrumb.latte', category: $topic->category, forum: $topic->forum, topic: $topic}

    <h1>{_forum-topic-delete.title}: {$topic->name}</h1>
    <p>{_forum-topic-delete.question}</p>

    {control deleteForm}
    <a n:href=":Forum:Topic:View:default $topic->uuid->toString()" class="btn btn-link">{_forum-topic-delete.cancel}</a>
{/block}
