{block title}{_forum-forum-rules.title}: {$forum->name}{/block}

{block content}
    {include '../../@breadcrumb.latte', category: $forum->category, forum: $forum}

    <h1>{_forum-forum-rules.title}</h1>

    <div n:if="$forum->rules" class="forum-rules">{$forum->rules|breakLines}</div>
    <p n:if="!$forum->rules" class="text-muted">{_forum-forum-rules.none}</p>
{/block}
