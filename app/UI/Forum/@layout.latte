{**
 * @param string   $basePath web base path
 * @param array    $flashes  flash messages
*}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">

    <title>{ifset title}{include title|stripHtml} | {/ifset}Nette Sandbox</title>

    <!--<meta name="viewport" content="width=device-width, initial-scale=1"> -->
    <link rel="stylesheet" href="{$basePath}/css/style.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css">
    {block head}{/block}
</head>

<body>
        <nav class="navbar navbar-expand-sm bg-dark navbar-dark mb-1">
            <div class="container-fluid">
            <ul class="navbar-nav">

            <li class={[nav-item, active => $presenter->getName() === 'Forum:Index']}>
                <a class="nav-link" n:href=":Forum:Index:default">{_forum-layout.index}</a>
            </li>

            {* search, member list, private messages and the profile come with their slices (users, PM) *}
            {if $user->isLoggedIn()}
                <li class="nav-item">
                    {* the own profile: Web:User:View without uuid finds it by the id of the logged-in user (the identity has no uuid) *}
                    <a class="nav-link own-profile-link" n:href=":Web:User:View:default">{$user->getIdentity()->getData()['username']}</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" n:href=":Web:User:Logout:default">{_forum-layout.logout}</a>
                </li>
            {else}
                <li class="nav-item">
                    <a class="nav-link" n:href=":Web:User:Login:default">{_forum-layout.login}</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" n:href=":Web:User:Registration:default">{_forum-layout.register}</a>
                </li>
            {/if}
        </ul>

        {* the role of the database is "Admin" (the old layout asked for "admin" and never showed the link) *}
        <ul n:if="$user->isInRole('Admin')" class="navbar-nav navbar-right">
            <li class="nav-item">
                <a class="nav-link admin-link" n:href=":Admin:User:List:default">{_forum-layout.admin}</a>
            </li>
        </ul>
    </div>
</nav>

<div class="col-sm-4 main">
    {foreach $flashes as $flash}
        <div class="alert alert-{$flash->type}">{_$flash->message}</div>
    {/foreach}
</div>

<div class="container-fluid">
    <div class="row">
        {include content}
    </div>
</div>
    
{import '../../presenters/templates/modal.latte'}
{include modal}

{block scripts}
    <script src="{$basePath}/js/jquery-3.3.1.min.js"></script>
    {*<script src="https://nette.github.io/resources/js/netteForms.min.js"></script>*}
    <script src="{$basePath}/js/main.js"></script>
    <script defer src="https://use.fontawesome.com/releases/v5.0.6/js/all.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js"></script>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script src="{$basePath}/js/tinymce/tinymce.min.js"></script>
    <script src="{$basePath}/js/nette.ajax.js"></script>
    <script defer src="{$basePath}/js/live-form-validation.js"></script>
    <script type="text/javascript">
        $(function () {
            $.nette.init();
        });
        
        tinyMCE.init({
            mode : "specific_textareas",
            editor_selector : "mceEditor",
            plugins: "image link code",
            toolbar: "undo redo | styleselect | bold italic | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image | code",
            convert_urls: false
        });
    </script> 
    <script>
        LiveForm.setOptions({
            messageErrorPrefix: 'Error: ',
            messageParentClass: 'has-error',
            wait: 500
        });
    </script>     
    
{/block}
</body>
</html>
